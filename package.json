{
  "name": "@corbits/xai-provider",
  "version": "0.1.0",
  "description": "xAI (Grok) OAuth config, token mapping, and a Responses adapter configured for xAI's CLI chat proxy.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "peerDependencies": {
    "@corbits/oauth-core": "^0.1.0",
    "@corbits/openai-responses": "^0.1.0",
    "@intx/inference": ">=0.4.0",
    "@intx/types": ">=0.4.0"
  },
  "devDependencies": {
    "@corbits/oauth-core": "0.1.0",
    "@corbits/openai-responses": "0.1.0",
    "@eslint/js": "9.34.0",
    "@intx/inference": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.14",
    "eslint": "9.34.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-xai-provider.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-xai-provider",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-xai-provider/issues"
  }
}
