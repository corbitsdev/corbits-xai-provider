{
  "name": "@corbits/xai-provider",
  "version": "0.1.0",
  "description": "xAI (Grok) OAuth config, token mapping, and a Responses adapter configured for xAI's CLI chat proxy.",
  "homepage": "https://github.com/corbitsdev/corbits-xai-provider",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-xai-provider/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-xai-provider.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "test:e2e": "bun test e2e"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@corbits/oauth-core": "0.1.0",
    "@corbits/openai-responses": "0.1.0",
    "@intx/inference": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@corbits/oauth-core": "^0.1.0",
    "@corbits/openai-responses": "^0.1.0",
    "@intx/inference": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
